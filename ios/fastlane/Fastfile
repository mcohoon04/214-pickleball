default_platform(:ios)

platform :ios do
  before_all do
    app_store_connect_api_key(
      key_id: "TM6A6P2MZH",
      issuer_id: "0be1c2d4-ad14-4265-8ff5-5201ada5fd70",
      key_filepath: "../keys/AuthKey_TM6A6P2MZH.p8",
      in_house: false
    )
  end

  desc "Build and upload a TestFlight build (no review submission)"
  lane :beta do
    build_app(
      project: "PickleBall214.xcodeproj",
      scheme: "PickleBall214",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      clean: true,
      xcargs: "-allowProvisioningUpdates"
    )
    upload_to_testflight(
      app_identifier: "com.214-pickle",
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end

  desc "Push metadata and screenshots to App Store Connect"
  lane :metadata do
    deliver(
      app_identifier: "com.214-pickle",
      skip_binary_upload: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      force: true,
      automatic_release: false,
      submit_for_review: false,
      precheck_include_in_app_purchases: false,
      submission_information: {
        export_compliance_uses_encryption: false,
        export_compliance_is_exempt: false,
        export_compliance_contains_proprietary_cryptography: false,
        export_compliance_contains_third_party_cryptography: false
      },
      app_rating_config_path: "fastlane/rating_config.json"
    )
  end

  desc "Submit the already-prepared version for review (no metadata/binary re-upload)"
  lane :resubmit do
    version = get_info_plist_value(path: "PickleBall214/Info.plist", key: "CFBundleShortVersionString")
    deliver(
      app_identifier: "com.214-pickle",
      app_version: version,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      force: true,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      submission_information: {
        export_compliance_uses_encryption: false,
        export_compliance_is_exempt: false,
        export_compliance_contains_proprietary_cryptography: false,
        export_compliance_contains_third_party_cryptography: false
      }
    )
  end

  desc "Push metadata and submit for review"
  lane :submit do
    version = get_info_plist_value(path: "PickleBall214/Info.plist", key: "CFBundleShortVersionString")
    deliver(
      app_identifier: "com.214-pickle",
      app_version: version,
      skip_binary_upload: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      force: true,
      automatic_release: false,
      submit_for_review: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        export_compliance_uses_encryption: false,
        export_compliance_is_exempt: false,
        export_compliance_contains_proprietary_cryptography: false,
        export_compliance_contains_third_party_cryptography: false
      },
      app_rating_config_path: "fastlane/rating_config.json"
    )
  end
end
